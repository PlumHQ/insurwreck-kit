# Copy this to .env.local, or just run `npm run setup` to fill it in automatically
# from ~/.insurwreck/credentials.json.

# Model calls — this is a proxy token, NOT a real Anthropic key. It only works
# against ANTHROPIC_BASE_URL (the hackathon metering endpoint), never api.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Resend — for the doc/email generator's "Send via email" button.
RESEND_API_KEY=
RESEND_FROM="Your App <you@example.com>"

# Optional — only needed if you flip the switch in lib/claims.ts to read from
# Supabase instead of the bundled seed data. See supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — personalizes the landing page. Safe to leave blank.
NEXT_PUBLIC_PARTICIPANT_NAME=
NEXT_PUBLIC_IDEA_BRIEF=
