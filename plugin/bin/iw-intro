#!/usr/bin/env bash
#
# Insurwreck — terminal intro.
#
# A static wordmark, printed once. There is deliberately no animation: the one
# place it could have run is here in the installer's terminal, and the payoff
# was not worth a moving target on event morning. Everywhere else it was never
# possible anyway — inside Claude Code stdout is captured rather than attached
# to a TTY, so ANSI escapes arrive as literal "[2K" junk and frames stack
# instead of overwriting.
#
# Two paths:
#
#   real terminal   →  wordmark in plum
#   not a terminal  →  wordmark in PLAIN TEXT, zero escape sequences
#
#   --plain    force the plain-text path

set -euo pipefail

MODE="auto"
for arg in "$@"; do
  case "$arg" in
    --plain)  MODE="plain" ;;
    --help|-h) echo "usage: iw-intro [--plain]"; exit 0 ;;
  esac
done

WORDMARK=' ___  _  _  ___  _   _  ___ __      __ ___  ___   ___  _  __
|_ _|| \| |/ __|| | | || _ \\ \    / /| _ \| __| / __|| |/ /
 | | | .` |\__ \| |_| ||   / \ \/\/ / |   /| _| | (__ | '"'"' <
|___||_|\_||___/ \___/ |_|_\  \_/\_/  |_|_\|___| \___||_|\_\'

# No date and no edition number: this banner outlived both last time.
EVENT="INSURWRECK · PLUM"
TAGLINE="Bring one real problem. Leave with a working prototype."

# Colour only when a real terminal is on the other end, and never when the
# caller has asked for plain text or set NO_COLOR.
if [ "$MODE" = "auto" ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  printf '\033[35m%s\033[0m\n\n' "$WORDMARK"
  printf '        \033[2m%s\033[0m\n\n' "$EVENT"
  printf '    %s\n' "$TAGLINE"
else
  printf '%s\n\n' "$WORDMARK"
  printf '        %s\n\n' "$EVENT"
  printf '    %s\n' "$TAGLINE"
fi
