#!/usr/bin/env bash
# Check everything a build needs and say what's wrong in plain English.
#
#   iw-doctor

set -uo pipefail

CREDS="$HOME/.insurwreck/credentials.json"
FAIL=0

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; R=$'\033[0m'; GRN=$'\033[32m'; YLW=$'\033[33m'; RED=$'\033[31m'; DIM=$'\033[2m'
else
  B=""; R=""; GRN=""; YLW=""; RED=""; DIM=""
fi

ok()   { printf "  ${GRN}✓${R} %s\n" "$1"; }
bad()  { printf "  ${RED}✗${R} %s\n" "$1"; FAIL=1; }
warn() { printf "  ${YLW}!${R} %s\n" "$1"; }
note() { printf "    ${DIM}%s${R}\n" "$1"; }

printf "\n${B}Checking your setup${R}\n\n"

# --- tools -----------------------------------------------------------------
for tool in node npm git claude; do
  if command -v "$tool" >/dev/null 2>&1; then
    ok "$tool"
  else
    case "$tool" in
      node|npm) bad "$tool is missing"; note "install Node from https://nodejs.org (LTS)" ;;
      git)      bad "git is missing"; note "on macOS run: xcode-select --install" ;;
      claude)   bad "claude is missing"; note "re-run the setup command from the invite" ;;
    esac
  fi
done

# --- the kit itself --------------------------------------------------------
# A stale kit is invisible from the inside: commands and MCP servers that were
# added after the participant extracted the tarball are simply absent, which
# looks like breakage rather than an old version. Worse, `claude plugin update`
# reports "already at the latest version" against a directory source, because
# there is nothing for it to fetch. So compare what is installed against what
# the marketplace directory on disk actually contains, and against main.
INSTALLED="$(claude plugin list 2>/dev/null \
  | awk '/insurwreck@insurwreck-kit/{f=1;next} f&&/Version:/{print $2;exit}')"
KIT_MANIFEST="$HOME/.insurwreck/kit/insurwreck-kit-main/plugin/.claude-plugin/plugin.json"
ON_DISK="$(node -e 'try{process.stdout.write(require(process.argv[1]).version)}catch{}' \
  "$KIT_MANIFEST" 2>/dev/null)"

if [ -z "$INSTALLED" ]; then
  warn "could not read the installed kit version"
  note "run: claude plugin list"
else
  LATEST="$(curl -fsSL --max-time 10 \
    https://raw.githubusercontent.com/PlumHQ/insurwreck-kit/main/plugin/.claude-plugin/plugin.json 2>/dev/null \
    | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{process.stdout.write(JSON.parse(d).version)}catch{}})' 2>/dev/null)"

  if [ -n "$LATEST" ] && [ "$INSTALLED" != "$LATEST" ]; then
    bad "your kit is out of date (have $INSTALLED, latest is $LATEST)"
    note "run /insurwreck:update inside Claude Code, then restart it"
    note "commands and MCP servers added after $INSTALLED are missing until you do"
  elif [ -n "$ON_DISK" ] && [ "$INSTALLED" != "$ON_DISK" ]; then
    # Re-fetched but not reinstalled: the usual half-finished update.
    warn "kit $ON_DISK is downloaded but $INSTALLED is still installed"
    note "run: claude plugin update insurwreck@insurwreck-kit, then restart Claude Code"
  elif [ -n "$LATEST" ]; then
    ok "kit $INSTALLED (latest)"
  else
    ok "kit $INSTALLED"
    note "could not reach GitHub to check for a newer one"
  fi
fi

# --- credentials -----------------------------------------------------------
if [ ! -f "$CREDS" ]; then
  bad "no credentials found"
  note "run /insurwreck:start inside Claude Code"
else
  ok "credentials file present"
  node -e '
    const c = require(process.argv[1]);
    const s = c.services || {};
    const rows = [
      ["vercel",    s.vercel?.token,            "deploy token"],
      ["supabase",  s.supabase?.service_role_key,"database keys"],
      ["resend",    s.resend?.api_key,          "email sending"],
      ["anthropic", s.anthropic?.api_key,       "model access"],
      ["agentmail", s.agentmail?.inbox_id,      "agent inbox"],
    ];
    const g = "\u001b[32m", y = "\u001b[33m", r = "\u001b[0m";
    for (const [name, value, label] of rows) {
      if (value) console.log(`  ${g}\u2713${r} ${name} (${label})`);
      else console.log(`  ${y}!${r} ${name} not ready yet (${label}) \u2014 run /insurwreck:status`);
    }
  ' "$CREDS" 2>/dev/null || warn "could not read credentials (is the file valid JSON?)"
fi

# --- the data servers ------------------------------------------------------
# These fail in three different ways that look identical from the outside:
# never written, written but this session predates it, and written but
# rejected. Each has a different fix, so name which one it is.
if [ -f "$CREDS" ]; then
  SETTINGS="$HOME/.claude/settings.json"
  IN_SETTINGS="$(node -e '
    try { const s = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
          process.stdout.write(s.env && s.env.INSURWRECK_TOKEN ? "yes" : "no"); }
    catch { process.stdout.write("no"); }
  ' "$SETTINGS" 2>/dev/null)"

  if [ "$IN_SETTINGS" != "yes" ]; then
    bad "the Plum data server is not switched on"
    note "run: iw-connect"
  elif [ -z "${INSURWRECK_TOKEN:-}" ]; then
    warn "the Plum data server is configured but this session started before it was"
    note "quit Claude Code and start it again"
  else
    CODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 \
      -X POST https://insurwreck-desk.preview.plumhq.com/api/mcp \
      -H "Authorization: Bearer $INSURWRECK_TOKEN" -H "Content-Type: application/json" \
      -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' 2>/dev/null)"
    case "$CODE" in
      200) ok "Plum data server reachable" ;;
      401) bad "the Plum data server rejected your token"; note "tell an organizer — your credential row may need re-minting" ;;
      *)   warn "could not reach the Plum data server (HTTP ${CODE:-000})"; note "check your network, then re-run iw-doctor" ;;
    esac
  fi
fi

# --- the classic deploy killer ---------------------------------------------
printf "\n${B}Checking this project${R}\n\n"

if [ -f package.json ]; then
  ok "package.json found"
  [ -d node_modules ] || { warn "dependencies not installed"; note "run: npm install"; }
else
  warn "no package.json here — are you in your project folder?"
fi

if [ -f .env ] || [ -f .env.local ]; then
  if [ -f .vercel/project.json ]; then
    warn "you have a local .env — those values do NOT reach Vercel automatically"
    note "your deployed site will break unless you add them in the Vercel dashboard"
    note "or pass them at deploy time; ask Claude: \"my env vars aren't on Vercel\""
  else
    ok ".env present (local only)"
  fi
fi

if git rev-parse --git-dir >/dev/null 2>&1; then
  if git check-ignore -q .env 2>/dev/null || ! [ -f .env ]; then
    ok "secrets are git-ignored"
  else
    bad ".env is NOT ignored by git — your keys could get published"
    note "add a line '.env*' to .gitignore before committing"
  fi
fi

printf "\n"
if [ "$FAIL" = "1" ]; then
  printf "${RED}${B}Some things need fixing.${R} Paste this whole output to Claude and ask it to fix them.\n\n"
  exit 1
fi
printf "${GRN}${B}All good.${R}\n\n"
