{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "functions": {
    "api/provision.js": {
      "maxDuration": 300
    },
    "api/llm/[...path].js": {
      "maxDuration": 300
    },
    "api/mcp.js": {
      "maxDuration": 300
    },
    "api/data/[card].js": {
      "maxDuration": 300
    },
    "api/slices.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/report.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/report",
      "destination": "/report.html"
    },
    {
      "source": "/go",
      "destination": "/go.sh"
    },
    {
      "source": "/win",
      "destination": "/go.ps1"
    },
    {
      "source": "/gui",
      "destination": "/go-gui.sh"
    },
    {
      "source": "/win-gui",
      "destination": "/go-gui.ps1"
    },
    {
      "source": "/api/llm/:path*",
      "destination": "/api/llm/[...path]"
    }
  ],
  "headers": [
    {
      "source": "/(go|go.sh|gui|go-gui.sh|win|go.ps1|win-gui|go-gui.ps1)",
      "headers": [
        {
          "key": "content-type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    }
  ],
  "regions": [
    "bom1"
  ]
}
