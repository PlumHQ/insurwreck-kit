# Credential desk environment — set these in the Vercel project, never commit real values.

# Supabase credential store (project: insurwreck-desk)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend: master key used to send OTP mail and mint per-participant sending keys
RESEND_API_KEY=
RESEND_FROM="Insurwreck 4.0 <insurwreck@badge.plumhq.com>"

# Vercel minting: team-scoped token creates per-participant projects on the
# Insurwreck team; the PERSONAL-scope token (full-account PAT) is required to
# mint per-participant access tokens — without it, tokens stay pending.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=insurwreck
VERCEL_USER_TOKEN=

# Supabase minting: management PAT creates one project per participant
SUPABASE_MGMT_TOKEN=
SUPABASE_ORG_ID=
SUPABASE_REGION=ap-south-1

# AgentMail: ONE org key, one inbox per participant. There is no per-inbox key
# — /v0/api-keys scopes by permission, not by inbox — so keep this key's
# permissions to the minimum (inbox create/read, message send/read).
AGENTMAIL_API_KEY=
# Leave unset to use agentmail.to. Set only once the custom domain reports
# VERIFIED - never point this at plumhq.com itself, whose MX carries company mail.
AGENTMAIL_DOMAIN=

# Anthropic: the single real key behind /api/llm. Participants never see it;
# they get a proxy token and the desk meters their spend against LLM_BUDGET_USD.
ANTHROPIC_API_KEY=
LLM_BUDGET_USD=15

# Metabase: backs the read-only data MCP server at /api/mcp. Use a DEDICATED
# service account, not an admin key - put it in a group with "Create queries:
# No" on the Warehouse and collection access only to the Insurwreck collection.
# The allowlist of runnable saved questions lives in the data_slices table and
# is managed at /slices.html - MCP_CARD_IDS is only an optional seed for the
# first boot, and a fallback if that table is unreachable.
METABASE_URL=https://stats2.plumhq.com
METABASE_API_KEY=
# A SECOND Metabase key, with native-query rights, used only for participants an
# organizer has explicitly granted full warehouse access. Leave unset to disable
# the escape hatch entirely. The ordinary key above is deliberately 403'd from
# /api/dataset and must stay that way.
METABASE_FULL_KEY=
# Shared secret DevOps configured on the stats2 proxy so this service is allowed
# through without opening stats2 to every other Vercel tenant. Sent as
# X-Insurwreck-Gate on every Metabase call. Unset is safe: calls 403 and the
# materialised snapshot in slice_cache serves instead.
METABASE_GATE_SECRET=
MCP_CARD_IDS=

# Plum base API: backs the live claims tools (list_claims / get_claim) on the
# same MCP server at /api/mcp. Unrelated to Metabase - these tools keep working
# through a stats2 outage, and stop working if this is unset.
#
# Not a member token: a member token scopes the queryset to that member, and the
# claims viewset widens it the moment a memberId is passed. Deliberate, org-wide
# access read from one place beats access riding on somebody's identity.
#
# Two credential types work, and the header is chosen from the token's shape:
# an opaque store token goes out as Access-Token, a dotted HS256 JWT from the
# auth gateway as X-Plum-Internal-Token. Prefer the opaque one - upstream
# verifies exp on the JWT, and a credential that can expire mid-event will.
PLUM_API_BASE=https://api.plumhq.com
PLUM_API_TOKEN=
# Salt for the stable pseudonyms that replace names, phone numbers and email
# addresses. Unsalted, a sha256 of a ten-digit phone number is brute-forced in
# seconds, so this is not optional - it just falls back to the service role key
# above when unset, which is one less thing to forget on the day. Changing it
# re-rolls every pseudonym.
CLAIMS_MASK_SALT=
# The one project allowed to see real email addresses. Comma separated, and only
# an override: the durable form is the unmask_email flag set per participant via
# /api/admin set_unmask_email. Names and phone numbers stay masked regardless.
CLAIMS_UNMASK_EMAILS=

# Absolute base URL of this deployment, used to build the api_base handed to
# participants. Defaults to the preview domain if unset.
DESK_BASE_URL=https://insurwreck-desk.preview.plumhq.com

# n8n: one shared organizer-hosted instance, handed to every participant and
# exposed as the `n8n` MCP server inside Claude Code.
N8N_TOKEN=
N8N_MCP_URL=https://workflow-stg.plumhq.com/mcp-server/http


# Google sign-in for participant apps. The OAuth consent screen must be
# INTERNAL to the plumhq.com Workspace org — that is the real domain lock.
# The secret is written straight into each participant's Supabase auth config
# and is never returned in a credential bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=insurwreck-leads

# Organizer key for /api/roster, /api/slices, /api/admin and the OTP echo.
ADMIN_KEY=
# Addresses that may use the organizer console with an ordinary OTP login,
# instead of pasting ADMIN_KEY into a browser. Comma separated.
ORGANIZER_EMAILS=

# Who may verify: the domain, plus comma-separated explicit exceptions
ALLOWED_DOMAIN=plumhq.com
ALLOWED_EMAILS=

# Kula: ONE organizer key handed to every participant, exposed as the `kula`
# MCP server. Kula has no OAuth and no per-user keys, so this CANNOT be scoped
# per participant, and its Application API key is "Full access" - the MCP server
# can create candidates and move applications between stages. Point this at a
# sandbox or demo workspace unless an organizer has decided otherwise.
# Who may hold the Kula key. DEFAULT DENY: unset means nobody, and the service
# simply stays pending for everyone. Comma-separated, same shape as
# CLEVERTAP_EMAILS and ALLOWED_EMAILS. Editable in the Vercel dashboard; a change
# takes effect on the next deploy, and only for mints after that.
# Removing someone stops future mints; it does NOT take back what is already on
# their machine (revoke their credentials row and clear the key from their
# ~/.claude/settings.json for that).
KULA_EMAILS=

KULA_API_KEY=

# Zendesk: ONE organizer-issued API token handed to every participant, exposed
# as the `zendesk` MCP server. Zendesk tokens authenticate the account, not the
# person, so this cannot be scoped per participant either. It points at a real
# support desk - block-zendesk-writes.sh denies the write tools, because
# zendesk_add_public_note emails the reply to the actual customer.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_TOKEN=

# CleverTap: ONE organizer-issued Account ID + Passcode handed to every
# participant, exposed as the `clevertap` MCP server. CleverTap's REST API
# authenticates the ACCOUNT, not the person, and offers no read-only passcode
# type - so this cannot be scoped per participant and the passcode carries full
# write access. block-clevertap-writes.sh is the only control, because
# clevertap_create_campaign sends real push, email and SMS to real members.
# Point this at a non-production CleverTap project if one exists.
# Who may hold the CleverTap credential. DEFAULT DENY: unset means nobody gets
# it, and the service simply stays pending for everyone. Comma-separated, same
# shape as ALLOWED_EMAILS. This is the only per-email gated service, because it
# is the only one whose blast radius is messages to real members.
# Removing someone here stops future mints; it does NOT take back what is already
# on their machine (revoke their credentials row and clear the three keys from
# their ~/.claude/settings.json for that).
CLEVERTAP_EMAILS=

# Parallel Search (https://search.parallel.ai/mcp) - live web search and fetch,
# for the ideas whose research the warehouse slices cannot answer. Hosted HTTP,
# so there is no package to install and nothing to prewarm.
#
# Gated like Kula and CleverTap, and DEFAULT DENY - but for a different reason:
# the key is metered, and one shared key spent by 137 people is a bill nobody
# chose. Both its tools (web_search, web_fetch) are read-only, so there is no
# write-block hook.
PARALLEL_EMAILS=
PARALLEL_API_KEY=

# A SECOND, NARROWER CleverTap list: who may also use the two campaign tools,
# clevertap_create_campaign and clevertap_stop_campaign, on top of the read
# surface. Kept separate from CLEVERTAP_EMAILS deliberately - being trusted to
# read engagement analytics is not the same decision as being trusted to send to
# real members, and one combined list would hide the bigger grant inside the
# smaller one.
#
# Everyone here must also be in CLEVERTAP_EMAILS; this list only widens.
# create_campaign with when:"now" SENDS - real push, email or SMS, immediately,
# no recall. Add someone only when their idea genuinely cannot be built read-only.
CLEVERTAP_CAMPAIGN_EMAILS=

CLEVERTAP_ACCOUNT_ID=
CLEVERTAP_PASSCODE=
# in1 (India), us1, eu1, sg1, aps3, mec1
CLEVERTAP_REGION=in1

# OpenAI, for embeddings only. Reached through /api/llm/openai/v1/embeddings,
# which whitelists that one path - the key itself also reaches chat completions,
# so the gateway bounds it, not the key. Only participants with an `openai`
# credentials row can use it; see desk/scripts for who and why.
OPENAI_API_KEY=

# Give every participant's Vercel project <name>.insurwreck.com instead of a
# vercel.app URL. Leave unset and nothing is assigned - which is the safe state
# until DNS is ready. Needs a DNS-only (unproxied) wildcard CNAME:
#   *.insurwreck.com  CNAME  cname.vercel-dns.com
# Proxied through Cloudflare it fails TLS to the origin and every subdomain
# returns HTTP 525.
INSURWRECK_APP_DOMAIN=
