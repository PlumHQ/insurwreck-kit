# Credential desk environment — set these in the Vercel project, never commit real values.

# Supabase credential store (project: insurwreck-desk)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend: master key used to send OTP mail and mint per-participant sending keys
RESEND_API_KEY=
RESEND_FROM="Insurwreck 4.0 <insurwreck@badge.plumhq.com>"

# Vercel minting: team-scoped token creates per-participant projects on the
# Insurwreck team; the PERSONAL-scope token (full-account PAT) is required to
# mint per-participant access tokens — without it, tokens stay pending.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=insurwreck
VERCEL_USER_TOKEN=

# Supabase minting: management PAT creates one project per participant
SUPABASE_MGMT_TOKEN=
SUPABASE_ORG_ID=
SUPABASE_REGION=ap-south-1

# AgentMail: ONE org key, one inbox per participant. There is no per-inbox key
# — /v0/api-keys scopes by permission, not by inbox — so keep this key's
# permissions to the minimum (inbox create/read, message send/read).
AGENTMAIL_API_KEY=
# Leave unset to use agentmail.to. Set only once the custom domain reports
# VERIFIED - never point this at plumhq.com itself, whose MX carries company mail.
AGENTMAIL_DOMAIN=

# Anthropic: the single real key behind /api/llm. Participants never see it;
# they get a proxy token and the desk meters their spend against LLM_BUDGET_USD.
ANTHROPIC_API_KEY=
LLM_BUDGET_USD=15

# Metabase: backs the read-only data MCP server at /api/mcp. Use a DEDICATED
# service account, not an admin key - put it in a group with "Create queries:
# No" on the Warehouse and collection access only to the Insurwreck collection.
# The allowlist of runnable saved questions lives in the data_slices table and
# is managed at /slices.html - MCP_CARD_IDS is only an optional seed for the
# first boot, and a fallback if that table is unreachable.
METABASE_URL=https://stats2.plumhq.com
METABASE_API_KEY=
# A SECOND Metabase key, with native-query rights, used only for participants an
# organizer has explicitly granted full warehouse access. Leave unset to disable
# the escape hatch entirely. The ordinary key above is deliberately 403'd from
# /api/dataset and must stay that way.
METABASE_FULL_KEY=
MCP_CARD_IDS=

# Absolute base URL of this deployment, used to build the api_base handed to
# participants. Defaults to the preview domain if unset.
DESK_BASE_URL=https://insurwreck-desk.preview.plumhq.com

# n8n: one shared organizer-hosted instance, handed to every participant and
# exposed as the `n8n` MCP server inside Claude Code.
N8N_TOKEN=
N8N_MCP_URL=https://workflow-stg.plumhq.com/mcp-server/http


# Google sign-in for participant apps. The OAuth consent screen must be
# INTERNAL to the plumhq.com Workspace org — that is the real domain lock.
# The secret is written straight into each participant's Supabase auth config
# and is never returned in a credential bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=insurwreck-leads

# Organizer key for /api/roster, /api/slices, /api/admin and the OTP echo.
ADMIN_KEY=
# Addresses that may use the organizer console with an ordinary OTP login,
# instead of pasting ADMIN_KEY into a browser. Comma separated.
ORGANIZER_EMAILS=

# Who may verify: the domain, plus comma-separated explicit exceptions
ALLOWED_DOMAIN=plumhq.com
ALLOWED_EMAILS=

# Kula: ONE organizer key handed to every participant, exposed as the `kula`
# MCP server. Kula has no OAuth and no per-user keys, so this CANNOT be scoped
# per participant, and its Application API key is "Full access" - the MCP server
# can create candidates and move applications between stages. Point this at a
# sandbox or demo workspace unless an organizer has decided otherwise.
KULA_API_KEY=

# Keka per-user OAuth, behind the keka MCP server at /api/keka-mcp. Register an
# OAuth app under Global admin settings > Integrations & Automations > API
# access with redirect URI $DESK_BASE_URL/api/keka-callback. Deliberately NO
# tenant API key: each participant authorises their own Keka account, so Keka
# enforces their permissions instead of this desk doing it.
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_LOGIN_HOST=login.keka.com
KEKA_SCOPE="kekaapi offline_access"
# Tenant API host, no trailing slash, e.g. https://plum.keka.com
KEKA_API_BASE=
